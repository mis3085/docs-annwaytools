        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%eb%82%b4%eb%b6%80-%eb%b3%b4%eb%a7%81-%ea%b3%bc%ec%a0%9c%ec%97%90-%eb%8c%80%ed%95%9c-%ec%b2%a8%eb%8b%a8-%ec%a0%91%ea%b7%bc%eb%b2%95&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
